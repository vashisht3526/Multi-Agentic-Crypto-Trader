SYMBOL=BTCUSDT
DB_PATH=./binance_ticks.duckdb
DASHBOARD_SNAPSHOT_PATH=./dashboard_snapshot.json
DASHBOARD_SNAPSHOT_INTERVAL_SECONDS=5
DASHBOARD_SNAPSHOT_ROWS=50
REPORTING_CAPITAL_BASE=100000
DB_LOCK_WAIT_SECONDS=10
DB_LOCK_FALLBACK=0
MAX_ALLOWED_TICK_GAP_SECONDS=10
SIGNAL_HORIZON_SECONDS=180
SIGNAL_EVAL_RETRY_SECONDS=30
MAX_SIGNAL_EVAL_DEFERRALS=3
LEARNING_MIN_SAMPLES=12
LOOKBACK_SECONDS=60
ANALYSIS_INTERVAL_SECONDS=20
MIN_TICKS_BEFORE_ANALYSIS=100
RECONNECT_BACKOFF_SECONDS=5
CREW_VERBOSE=0

# Preferred: Groq (if provided, this takes precedence over OPENAI_*).
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback: OpenAI.
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
