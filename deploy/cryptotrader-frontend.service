[Unit]
Description=Chronos Frontend
After=network-online.target cryptotrader.service
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/cryptotrader/frontend
Environment=NODE_ENV=production
ExecStart=/bin/bash -lc 'source /home/azureuser/.nvm/nvm.sh && nvm use 22 >/dev/null && npm run preview -- --host 0.0.0.0 --port 5173'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
